---
layout: layouts/base.njk
section: post
---

<article class="livret">
	<div class="livret-page">
		<h1>{{ title }}</h1>
		<p class="auteur"><time datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time></p>

		<div class="texte">
			{{ layoutContent | safe }}
		</div>
	</div>
</article>

{% set suivant = collections.post | getPreviousCollectionItem(page) %}
{% if suivant %}
	<p class="suite"><a href="{{ suivant.url }}">Article précédent : {{ suivant.data.title }}</a></p>
{% endif %}
