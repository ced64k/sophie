---
layout: layouts/base.njk
section: post
---

<header class="titre-page">
	<h1>{{ title }}</h1>
	<p class="titre-meta"><time class="etiquette" datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time></p>
</header>

{% if image %}
<div class="couverture"><img src="{{ image | vignette(1600) }}" alt="" fetchpriority="high"></div>
{% endif %}

<article class="livret{% if image %} livret-couverture{% endif %}">
	<div class="livret-page">
		<div class="texte">
			{{ content | safe }}
		</div>
	</div>
</article>

{% set suivant = collections.post | getPreviousCollectionItem(page) %}
{% if suivant %}
	<p class="suite"><a href="{{ suivant.url }}">Article précédent : {{ suivant.data.title }}</a></p>
{% endif %}
