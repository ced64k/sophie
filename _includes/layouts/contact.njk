---
layout: layouts/base.njk
section: contact
---

<header class="titre-page">
	<h1>{{ title }}</h1>
</header>

<article class="livret">
	<div class="livret-page large">
		<div class="texte chapeau">
			{{ layoutContent | safe }}
		</div>

		<div class="contact-grille">
			<section class="contact-lieux" aria-labelledby="titre-appeler">
				<h2 id="titre-appeler">Appeler</h2>
				{% for lieu in lieux %}
					<div class="lieu-carte">
						<p class="lieu-ville"><svg class="pin" aria-hidden="true" focusable="false"><use href="#pin"/></svg>{{ lieu.ville }}</p>
						<p>{{ lieu.structure }}<br>{{ lieu.adresse }}</p>
						<p class="lieu-contacts">
							<a class="lieu-lien lieu-tel" href="tel:{{ lieu.telephone | replace(' ', '') }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 3.2c.5-.5 1.3-.5 1.8 0l2 2.4c.4.5.4 1.2 0 1.7L9.3 8.6c1 2.1 2.6 3.9 4.6 5l1.4-1.1c.5-.4 1.2-.4 1.7 0l2.4 2c.5.5.5 1.300 0 1.800l-1.300 1.400c-.8.8-2 1.100-3.100.7C9.300 17.500 6 14.100 3.800 8.700c-.4-1.100-.1-2.300.7-3.100z" fill="currentColor"/></svg>{{ lieu.telephone }}</a>
							<a class="lieu-lien lieu-mail" href="mailto:{{ lieu.email }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6.500C4 5.700 4.700 5 5.500 5h13c.8 0 1.500.7 1.500 1.500v11c0 .8-.7 1.500-1.500 1.500h-13C4.700 19 4 18.300 4 17.500zm2 .9v.3l6 4.100 6-4.100v-.3z" fill="currentColor"/></svg>{{ lieu.email }}</a>
						</p>
						{% if lieu.provisoire %}<p class="provisoire">Coordonnées provisoires, à remplacer</p>{% endif %}
					</div>
				{% endfor %}
			</section>

			<section aria-labelledby="titre-ecrire">
				<h2 id="titre-ecrire">Écrire à Sophie</h2>
				{% include "components/form.njk" %}
			</section>
		</div>
	</div>
</article>
