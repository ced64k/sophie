<!doctype html>
<html lang="fr-BE"{% if section %} data-section="{{ section }}"{% endif %}>

	{% include "components/head.njk" %}

	<body>
		<a class="evitement" href="#contenu">Aller au contenu</a>

		{# Tache de couleur d'un domaine sur les cartes de fiches (la couleur vient du CSS) #}
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<symbol id="puce" viewBox="0 0 24 24">
				<path d="M12.5 2.5c5.8.2 10 4.3 9.6 9.9-.4 5.4-4.9 9.3-10.6 9.1C5.9 21.3 1.8 17.4 2 11.9 2.2 6.2 6.6 2.3 12.5 2.5z" fill="var(--puce, currentColor)"/>
			</symbol>
		</svg>

		{% if section != "home" %}
			{% include "components/entete.njk" %}
		{% endif %}

		<main id="contenu">
			{{ layoutContent | safe }}
		</main>

		{% include "components/footer.njk" %}

		<script>
			// Menu mobile
			document.querySelectorAll(".nav-toggle").forEach(function (b) {
				b.addEventListener("click", function () {
					var ouvert = b.getAttribute("aria-expanded") === "true";
					b.setAttribute("aria-expanded", ouvert ? "false" : "true");
				});
			});
		</script>

		{% if filtres %}
			{% set js %}{% include "assets/js/filtres.js" %}{% endset %}
			<script>{{ js | jsmin | safe }}</script>
		{% endif %}
	</body>

</html>
