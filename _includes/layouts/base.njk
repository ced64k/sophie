<!doctype html>
<html lang="fr-BE"{% if section %} data-section="{{ section }}"{% endif %}>

	{% include "components/head.njk" %}

	<body>
		<a class="evitement" href="#contenu">Aller au contenu</a>

		{# Pastille de couleur d'un domaine (la couleur vient du CSS) #}
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<symbol id="puce" viewBox="0 0 24 24">
				<circle cx="12" cy="12" r="10" fill="var(--puce, currentColor)" stroke="var(--encre)" stroke-width="2"/>
			</symbol>
		</svg>

		{% if section != "home" %}
			{% include "components/entete.njk" %}
		{% endif %}

		<main id="contenu">
			{{ layoutContent | safe }}
		</main>

		{% include "components/footer.njk" %}

		<script>
			// Menu mobile
			document.querySelectorAll(".nav-toggle").forEach(function (b) {
				b.addEventListener("click", function () {
					var ouvert = b.getAttribute("aria-expanded") === "true";
					b.setAttribute("aria-expanded", ouvert ? "false" : "true");
				});
			});
		</script>

		{% if filtres %}
			{% set js %}{% include "assets/js/filtres.js" %}{% endset %}
			<script>{{ js | jsmin | safe }}</script>
		{% endif %}
	</body>

</html>
