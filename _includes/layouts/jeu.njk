---
layout: layouts/base.njk
section: jeu
---

{% set sections = content | sectionsFiche %}
{% set infos = [
	{ nom: "Marque", valeur: marque },
	{ nom: "Âge", valeur: age },
	{ nom: "Joueurs", valeur: joueurs },
	{ nom: "Durée", valeur: duree },
	{ nom: "Prix indicatif", valeur: prix }
] | selectattr("valeur") %}
<header class="titre-page">
	<h1>{{ title }}</h1>
	<p class="titre-meta"><span class="etiquette">Fiche de {{ author }}</span></p>
</header>

<article class="livret fiche-jeu">
	<div class="livret-page">
		<div class="fiche-entete{% if not infos | length %} sans-infos{% endif %}">
		{% if sections.length %}
			<div class="sommaire" role="group" aria-label="Variantes de la fiche">
				<p class="sommaire-titre">Les variantes</p>
				<ul>
					{% for s in sections %}
						{% set d = domaines | domaine(s.domaine) if s.domaine %}
						<li><a class="sommaire-item"{% if s.id %} href="#{{ s.id }}"{% endif %}{% if d %} style="--puce: {{ d.couleur }}"{% endif %}>{% if d %}<span class="marque">{{ s.titre }}</span>{% else %}{{ s.titre }}{% endif %}</a></li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}
		{% if infos | length %}
			<dl class="fiche-infos" aria-label="Informations sur le jeu">
				{% for i in infos %}
					<div><dt>{{ i.nom }}</dt><dd>{{ i.valeur }}</dd></div>
				{% endfor %}
			</dl>
		{% endif %}
		</div>

		<div class="texte">
			{{ content | puceFiche | safe }}
		</div>
	</div>
</article>

{% set suivante = collections.jeux | getNextCollectionItem(page) or collections.jeux[0] %}
<p class="suite"><a href="{{ suivante.url }}">Fiche suivante : {{ suivante.data.title }}</a></p>
