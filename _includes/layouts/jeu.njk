---
layout: layouts/base.njk
section: jeu
---

{% set sections = content | sectionsFiche %}
{% set infos = [
	{ nom: "Marque", valeur: marque, icone: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12.2V4a1 1 0 0 1 1-1h8.2a1 1 0 0 1 .7.3l8 8a1 1 0 0 1 0 1.4l-7.2 7.2a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7Z"/><circle cx="8" cy="8" r="1.4"/></svg>' },
	{ nom: "Âge", valeur: age, icone: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2Z"/><path d="M8 12V9m4 3V8m4 4V9"/><path d="M8 6.2c-.8-.9 0-1.7 0-2.2 0 .5.8 1.3 0 2.2Zm4-1c-.8-.9 0-1.7 0-2.2 0 .5.8 1.3 0 2.2Zm4 1c-.8-.9 0-1.7 0-2.2 0 .5.8 1.3 0 2.2Z"/></svg>' }
] | selectattr("valeur") %}
<header class="titre-page">
	<h1>{{ title }}</h1>
	<p class="titre-meta"><span class="etiquette">Fiche de {{ author }}</span></p>
</header>

<article class="livret fiche-jeu">
	<div class="livret-page">
		<div class="fiche-entete{% if not infos | length %} sans-infos{% endif %}">
		{% if sections.length %}
			<div class="sommaire" role="group" aria-label="Variantes de la fiche">
				<p class="sommaire-titre">Les variantes</p>
				<ul>
					{% for s in sections %}
						{% set d = domaines | domaine(s.domaine) if s.domaine %}
						<li><a class="sommaire-item"{% if s.id %} href="#{{ s.id }}"{% endif %}{% if d %} style="--puce: {{ d.couleur }}"{% endif %}>{% if d %}<span class="marque">{{ s.titre }}</span>{% else %}{{ s.titre }}{% endif %}</a></li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}
		{% if infos | length %}
			<div class="fiche-bloc-infos">
			<p class="sommaire-titre">Infos</p>
			<dl class="fiche-infos">
				{% for i in infos %}
					<div><dt title="{{ i.nom }}">{{ i.icone | safe }}<span class="cache">{{ i.nom }}</span></dt><dd>{{ i.valeur }}</dd></div>
				{% endfor %}
			</dl>
			</div>
		{% endif %}
		</div>

		<div class="texte">
			{{ content | puceFiche | safe }}
		</div>
	</div>
</article>

{% set suivante = collections.jeux | getNextCollectionItem(page) or collections.jeux[0] %}
<p class="suite"><a href="{{ suivante.url }}">Fiche suivante : {{ suivante.data.title }}</a></p>
