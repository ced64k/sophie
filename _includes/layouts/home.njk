---
layout: layouts/base.njk
section: home
---

<section class="accueil" aria-labelledby="titre-accueil">
	<span class="tache tache-1" data-parallaxe=".38" aria-hidden="true"></span>
	<span class="tache tache-2" data-parallaxe="-.16" aria-hidden="true"></span>

	{% include "components/entete.njk" %}

	<div class="accueil-face">
		<h1 id="titre-accueil">La logopédie, ça se <span class="surligne">joue</span>&nbsp;!</h1>
		<p class="accueil-intro">Sophie Lenaerts, {{ intro | replace('Logopède ', 'logopède ') | replace('Elouges', '<span class="lieu"><svg class="pin" aria-hidden="true" focusable="false"><use href="#pin"/></svg>Elouges</span>') | replace('Ath', '<span class="lieu"><svg class="pin" aria-hidden="true" focusable="false"><use href="#pin"/></svg>Ath</span>') | safe }} Conventionnée INAMI.</p>
		<div class="accueil-actions">
			<a class="bouton" href="/contact/">Prendre contact</a>
		</div>
	</div>

	<div class="accueil-pied">
		{% set frimousseId = "accueil" %}
		{% include "components/frimousse.njk" %}

		<div class="accueil-infos">
		<nav class="legende" aria-label="Domaines pris en charge">
			<ul>
				{% for d in domaines %}
					<li><a href="/prises-en-charge/#{{ d.id }}" style="--puce: {{ d.couleur }}"><span class="marque">{{ d.nom }}</span></a></li>
				{% endfor %}
			</ul>
		</nav>

		</div>
	</div>
</section>

<div class="suite-accueil">
	<span class="tache tache-page tache-3" data-parallaxe="-.22" data-relatif style="right:-7vw;top:5%;width:clamp(160px,20vw,300px);aspect-ratio:1.2;border-radius:50% 50% 45% 55%" aria-hidden="true"></span>
	<span class="tache tache-page tache-4" data-parallaxe=".3" data-relatif style="left:-9vw;top:17%;width:clamp(120px,15vw,230px);aspect-ratio:1.5;border-radius:60% 40% 50% 50%" aria-hidden="true"></span>
	<span class="tache tache-page tache-5" data-parallaxe=".18" data-relatif style="right:-10vw;top:30%;width:clamp(240px,32vw,480px);aspect-ratio:1.3;border-radius:45% 55% 60% 40%" aria-hidden="true"></span>
	<span class="tache tache-page tache-6" data-parallaxe="-.28" data-relatif style="left:-5vw;top:44%;width:clamp(100px,12vw,180px);aspect-ratio:1;border-radius:50%" aria-hidden="true"></span>
	<span class="tache tache-page tache-7" data-parallaxe=".32" data-relatif style="right:-6vw;top:57%;width:clamp(140px,18vw,270px);aspect-ratio:1.6;border-radius:55% 45% 50% 50%" aria-hidden="true"></span>
	<span class="tache tache-page tache-8" data-parallaxe="-.14" data-relatif style="left:-12vw;top:68%;width:clamp(260px,34vw,500px);aspect-ratio:1.35;border-radius:50% 50% 40% 60%" aria-hidden="true"></span>
	<span class="tache tache-page tache-9" data-parallaxe="-.3" data-relatif style="right:-4vw;top:82%;width:clamp(110px,14vw,210px);aspect-ratio:1.1;border-radius:60% 40% 55% 45%" aria-hidden="true"></span>
	<span class="tache tache-page tache-10" data-parallaxe=".22" data-relatif style="left:-6vw;top:93%;width:clamp(150px,19vw,280px);aspect-ratio:1.5;border-radius:50% 50% 55% 45%" aria-hidden="true"></span>

<section class="regles livret" aria-labelledby="titre-regles">
	<div class="livret-page">
		<h2 id="titre-regles">Mon approche</h2>
		<div class="regles-liste">
			{{ content | safe }}
		</div>
	</div>
	<p class="lien-hors"><a class="lien-fort" href="/qui-suis-je/">Mon parcours</a></p>
</section>

<section class="etagere" aria-labelledby="titre-etagere">
	<div class="section-tete">
		<h2 id="titre-etagere">Les jeux du commerce et leur utilisation en séances</h2>
		<p>Chaque fiche détourne un jeu qu'on trouve en magasin, domaine par domaine, pour que les parents puissent le refaire à la maison.</p>
	</div>
	{% set sousLaFlottaison = true %}
	{% set fiches = collections.jeux %}
	{% set limite = 8 %}
	{% include "components/fiches.njk" %}
	{% set limite = null %}
	<p class="section-pied"><a class="lien-fort" href="/jeux/">Toutes les fiches jeux</a></p>
</section>

<section class="derniers livret" aria-labelledby="titre-articles">
	<div class="livret-page large">
		<h2 id="titre-articles">Derniers articles</h2>
		{% set articles = collections.post | reverse %}
		{% set limite = 3 %}
		{% include "components/articles.njk" %}
	</div>
	<p class="lien-hors"><a class="lien-fort" href="/blog/">Tous les articles</a></p>
</section>

<section class="bandeau-jeux" aria-labelledby="titre-jeux-en-ligne">
	<div>
		<h2 id="titre-jeux-en-ligne">Les jeux en ligne</h2>
		<p>Des jeux conçus par des logopèdes et par des patients, à jouer en séance ou à la maison : lecture, grammaire, cognition mathématique, langage oral.</p>
	</div>
	<a class="bouton bouton-encre" href="{{ jeuxEnLigne }}">Ouvrir les jeux en ligne</a>
</section>
</div>

<script>
	// Phone sliders ("Mon approche", shop-bought games): step-by-step scrolling, with dots to jump straight to a slide
	(function () {
		function slider(liste, libelle, apres) {
			if (!liste) return;
			var etapes = liste.children;
			var points = document.createElement("div");
			points.className = "slider-points";
			points.setAttribute("role", "group");
			points.setAttribute("aria-label", libelle);
			Array.prototype.forEach.call(etapes, function (e, i) {
				var b = document.createElement("button");
				b.type = "button";
				b.setAttribute("aria-label", "Diapositive " + (i + 1) + " sur " + etapes.length);
				b.addEventListener("click", function () { liste.scrollTo({ left: etapes[i].offsetLeft - etapes[0].offsetLeft, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); });
				points.appendChild(b);
			});
			(apres || liste).insertAdjacentElement("afterend", points);
			function maj() {
				var pas = etapes.length > 1 ? etapes[1].offsetLeft - etapes[0].offsetLeft : liste.clientWidth;
				var i = Math.round(liste.scrollLeft / Math.max(pas, 1));
				Array.prototype.forEach.call(points.children, function (b, k) {
					if (k === i) b.setAttribute("aria-current", "true"); else b.removeAttribute("aria-current");
				});
			}
			liste.addEventListener("scroll", maj, { passive: true });
			maj();
		}
		var approche = document.querySelector(".regles-liste");
		slider(approche, "Étapes de mon approche", approche && approche.closest(".livret-page"));
		slider(document.querySelector(".etagere .fiches"), "Fiches jeux");
	})();

	// The koala's eye highlights follow the pointer
	(function () {
		var f = document.querySelector(".accueil .frimousse");
		if (!f || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var pupilles = f.querySelectorAll(".pupille");
		var attente = false;
		addEventListener("pointermove", function (e) {
			if (attente) return;
			attente = true;
			requestAnimationFrame(function () {
				attente = false;
				var r = f.getBoundingClientRect();
				var dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
				var dy = (e.clientY - (r.top + r.height * .6)) / innerHeight;
				var x = Math.max(-1, Math.min(1, dx * 2)) * 6;
				var y = Math.max(-1, Math.min(1, dy * 2)) * 6;
				pupilles.forEach(function (p) { p.style.transform = "translate(" + x + "px," + y + "px)"; });
			});
		}, { passive: true });
	})();
</script>
