---
layout: layouts/base.njk
section: home
---

<section class="accueil" aria-labelledby="titre-accueil">
	<span class="tache tache-1" aria-hidden="true"></span>
	<span class="tache tache-2" aria-hidden="true"></span>

	{% include "components/entete.njk" %}

	<div class="accueil-face">
		<h1 id="titre-accueil">La logopédie, ça se <span class="surligne">joue</span>&nbsp;!</h1>
		<p class="accueil-intro">Sophie Lenaerts, {{ intro | replace('Logopède ', 'logopède ') }} Conventionnée INAMI.</p>
		<div class="accueil-actions">
			<a class="bouton" href="/contact/">Prendre contact</a>
		</div>
	</div>

	<div class="accueil-pied">
		{% set frimousseId = "accueil" %}
		{% include "components/frimousse.njk" %}

		<div class="accueil-infos">
		<nav class="legende" aria-label="Domaines pris en charge">
			<ul>
				{% for d in domaines %}
					<li><a href="/prises-en-charge/#{{ d.id }}" style="--puce: {{ d.couleur }}"><svg class="puce" aria-hidden="true"><use href="#puce"/></svg>{{ d.nom }}</a></li>
				{% endfor %}
			</ul>
		</nav>

		<ul class="accueil-lieux" aria-label="Où consulter">
			{% for lieu in lieux | reverse %}
				<li><p class="lieu-structure">{{ lieu.structure }}</p><p>{{ lieu.ville }}</p></li>
			{% endfor %}
		</ul>
		</div>
	</div>
</section>

<section class="regles livret" aria-labelledby="titre-regles">
	<div class="livret-page">
		<h2 id="titre-regles">Les règles du jeu</h2>
		{{ layoutContent | safe }}
		<p><a class="lien-fort" href="/qui-suis-je/">Mon parcours</a></p>
	</div>
</section>

<section class="etagere" aria-labelledby="titre-etagere">
	<div class="section-tete">
		<h2 id="titre-etagere">Les jeux du commerce et leur utilisation en séances</h2>
		<p>Chaque fiche détourne un jeu qu'on trouve en magasin, domaine par domaine, pour que les parents puissent le refaire à la maison.</p>
	</div>
	{% set fiches = collections.jeux %}
	{% include "components/fiches.njk" %}
	<p class="section-pied"><a class="lien-fort" href="/jeux/">Toutes les fiches jeux</a></p>
</section>

<section class="derniers livret" aria-labelledby="titre-articles">
	<div class="livret-page large">
		<h2 id="titre-articles">Derniers articles</h2>
		{% set articles = collections.post | reverse %}
		{% set limite = 3 %}
		{% include "components/articles.njk" %}
		<p><a class="lien-fort" href="/blog/">Tous les articles</a></p>
	</div>
</section>

<section class="bandeau-jeux" aria-labelledby="titre-jeux-en-ligne">
	<div>
		<h2 id="titre-jeux-en-ligne">Les jeux en ligne</h2>
		<p>Des jeux conçus par des logopèdes et par des patients, à jouer en séance ou à la maison : lecture, grammaire, cognition mathématique, langage oral.</p>
	</div>
	<a class="bouton bouton-encre" href="{{ metadata.jeuxEnLigne }}">Ouvrir les jeux en ligne</a>
</section>

<script>
	// Les yeux de la frimousse suivent le pointeur
	(function () {
		var f = document.querySelector(".accueil .frimousse");
		if (!f || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var pupilles = f.querySelectorAll(".pupille");
		var attente = false;
		addEventListener("pointermove", function (e) {
			if (attente) return;
			attente = true;
			requestAnimationFrame(function () {
				attente = false;
				var r = f.getBoundingClientRect();
				var dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
				var dy = (e.clientY - (r.top + r.height * .6)) / innerHeight;
				var x = Math.max(-1, Math.min(1, dx * 2)) * 10;
				var y = Math.max(-1, Math.min(1, dy * 2)) * 14;
				pupilles.forEach(function (p) { p.style.transform = "translate(" + x + "px," + y + "px)"; });
			});
		}, { passive: true });
	})();
</script>
