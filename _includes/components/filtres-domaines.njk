{# Filtres par domaine : filtre la liste [data-liste] de la page par domaine #}
<div class="filtres" role="group" aria-label="Filtrer par domaine">
	<button type="button" class="filtre" data-filtre="domaines" data-valeur="" aria-pressed="true">Tous</button>
	{% for d in domaines %}
		{% if d.id != "precoce" and d.id != "begaiement" %}
			<button type="button" class="filtre" data-filtre="domaines" data-valeur="{{ d.id }}" aria-pressed="false" style="--puce: {{ d.couleur }}"><svg class="puce" aria-hidden="true"><use href="#puce"/></svg>{{ d.nom }}</button>
		{% endif %}
	{% endfor %}
</div>
