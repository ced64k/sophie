<head>
  <meta charset="utf-8">
  <meta name="generator" content="{{ eleventy.generator }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ metaDescription or summary or metadata.description }}">
  <meta name="theme-color" content="#A3D9CB">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {%- if section == 'partage' %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- set ogSlug = page | ogCarte({ title: title, author: author, categories: categories, tags: tags, image: image, ogTitre: ogTitre, ogEtiquette: ogEtiquette, ogBouton: ogBouton }, content) %}
  {%- set ogDescription = ({ metaDescription: metaDescription, summary: summary } | ogDescription(content, metadata.description)) if (section == 'post' or section == 'jeu') else (metaDescription or summary or metadata.description) %}
  <link rel="canonical" href="{{ siteUrl }}{{ page.url }}">
  <meta property="og:site_name" content="Sophie Lenaerts, logopède">
  <meta property="og:locale" content="fr_BE">
  <meta property="og:type" content="{% if section == 'post' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title and page.url != '/' %}{{ title }}{% else %}{{ metadata.title }}{% endif %}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ siteUrl }}/og/{{ ogSlug }}.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{% if title and page.url != '/' %}{{ title }}{% else %}{{ metadata.title }}{% endif %} · sophielogo.be">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/static/fonts/fredoka.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/atkinson-400.woff2" as="font" type="font/woff2" crossorigin>
  {% set css %}
    {% include "assets/css/site.css" %}
  {% endset %}
  <style>{{ css | cssmin | safe }}</style>
  {# GoatCounter (stats.sophielogo.be, sans cookies ; pas sur la version de test) #}
  {% if siteUrl == "https://sophielogo.be" %}
  <script data-goatcounter="https://stats.sophielogo.be/count" async src="https://stats.sophielogo.be/count.js"></script>
  {% endif %}
</head>
