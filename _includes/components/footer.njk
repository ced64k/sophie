<footer class="pied">
  {% set frimousseId = "pied" %}
  {% include "components/frimousse.njk" %}
  <div class="pied-grille">
    <div class="pied-bloc">
      <p class="pied-nom">Sophie Lenaerts, logopède</p>
      <p>Conventionnée INAMI. Enfants de l'âge préscolaire au début du secondaire.</p>
      <p><a href="/contact/">Prendre contact</a></p>
    </div>
    {% for lieu in lieux %}
      <div class="pied-bloc">
        <p class="pied-titre"><svg class="pin" aria-hidden="true" focusable="false"><use href="#pin"/></svg>{{ lieu.ville | replace(" (Dour)", "") }}<span class="ville-precision">{% if " (Dour)" in lieu.ville %} (Dour){% endif %}</span></p>
        <p>{{ lieu.structure }}<br>{{ lieu.adresse }}<br><a class="tel" href="tel:{{ lieu.telephone | replace(' ', '') }}">{{ lieu.telephone }}</a></p>
        {% if lieu.provisoire %}<p class="provisoire">Coordonnées provisoires, à remplacer</p>{% endif %}
      </div>
    {% endfor %}
    <div class="pied-bloc">
      <p><a class="pied-reseau" href="{{ metadata.facebook }}" aria-label="Page Facebook" title="Page Facebook"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect width="24" height="24" rx="6.5" fill="var(--jaune)"/><path fill="var(--encre)" transform="translate(12 12) scale(.8) translate(-12 -12)" d="M16.671 15.543l.532-3.47h-3.328v-2.25c0-.949.465-1.874 1.956-1.874h1.513V4.996s-1.374-.235-2.686-.235c-2.741 0-4.533 1.662-4.533 4.669v2.642H7.078v3.47h3.047v8.385a12.118 12.118 0 003.75 0v-8.385h2.796z"/></svg></a></p>
    </div>
  </div>
  <p class="pied-droits">Les textes des fiches jeux sont soumis aux droits d'auteur : merci de demander l'autorisation avant toute reprise.</p>
</footer>
