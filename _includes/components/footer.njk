<footer class="pied">
  <div class="pied-grille">
    <div class="pied-bloc">
      <p class="pied-nom">Sophie Lenaerts, logopède</p>
      <p>Conventionnée INAMI. Enfants de l'âge préscolaire au début du secondaire.</p>
      <p><a href="/contact/">Écrire à Sophie</a></p>
    </div>
    {% for lieu in lieux %}
      <div class="pied-bloc">
        <p class="pied-titre">{{ lieu.ville }}</p>
        <p>{{ lieu.structure }}<br>{{ lieu.adresse }}<br><a href="tel:{{ lieu.telephone | replace(' ', '') }}">{{ lieu.telephone }}</a></p>
        {% if lieu.provisoire %}<p class="provisoire">Coordonnées provisoires, à remplacer</p>{% endif %}
      </div>
    {% endfor %}
    <div class="pied-bloc">
      <p class="pied-titre">Ailleurs</p>
      <p><a href="{{ metadata.jeuxEnLigne }}">Les jeux en ligne</a><br><a href="{{ metadata.facebook }}">Page Facebook</a></p>
    </div>
  </div>
  <p class="pied-droits">Les textes des fiches jeux sont soumis aux droits d'auteur : merci de demander l'autorisation avant toute reprise.</p>
</footer>
