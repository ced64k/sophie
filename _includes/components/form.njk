{# L'envoi sera branché sur un script du VPS (/contact/envoyer) #}
<form class="formulaire" method="post" action="/contact/envoyer">
  <p class="champ">
    <label for="nom">Votre nom</label>
    <input type="text" name="nom" id="nom" autocomplete="name" required>
  </p>
  <p class="champ">
    <label for="email">Votre e-mail</label>
    <input type="email" name="email" id="email" autocomplete="email" required>
  </p>
  <p class="champ">
    <label for="telephone">Téléphone <span>(facultatif)</span></label>
    <input type="tel" name="telephone" id="telephone" autocomplete="tel">
  </p>
  <p class="champ">
    <label for="message">Votre message</label>
    <textarea name="message" id="message" rows="7" required aria-describedby="aide-message"></textarea>
    <span class="aide" id="aide-message">Indiquez l'âge de l'enfant et ce qui vous amène, si vous le souhaitez.</span>
  </p>
  <p class="piege" aria-hidden="true"><label>Ne pas remplir <input type="text" name="site" tabindex="-1" autocomplete="off"></label></p>
  <button class="bouton" type="submit">Envoyer le message</button>
</form>
