{% set navPages = collections.all | eleventyNavigation %}
<nav class="nav" aria-label="Navigation principale">
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-liens" aria-label="Menu"><span class="nav-toggle-texte">Menu</span></button>
  <ul class="nav-liens" id="nav-liens">
    {%- for entry in navPages %}
      <li><a href="{{ entry.url | url }}"{% if entry.url == page.url or (entry.url != "/" and page.url.startsWith(entry.url)) %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
    {%- endfor %}
