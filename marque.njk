<script>
	// Les reflets des yeux des deux koalas suivent le pointeur, comme sur l'accueil
	(function () {
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var koalas = document.querySelectorAll(".frimousse");
		var attente = false;
		addEventListener("pointermove", function (e) {
			if (attente) return;
			attente = true;
			requestAnimationFrame(function () {
				attente = false;
				koalas.forEach(function (f) {
					var r = f.getBoundingClientRect();
					var dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
					var dy = (e.clientY - (r.top + r.height * .6)) / innerHeight;
					var x = Math.max(-1, Math.min(1, dx * 2)) * 6;
					var y = Math.max(-1, Math.min(1, dy * 2)) * 6;
					f.querySelectorAll(".pupille").forEach(function (p) { p.style.transform = "translate(" + x + "px," + y + "px)"; });
				});
			});
		}, { passive: true });
	})();
</script>
</body>
</html>
