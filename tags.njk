---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - jeu
    - jeux
permalink: /tags/{{ tag }}/
layout: layouts/base.njk
eleventyComputed:
  title: "Articles « {{ tag }} »"
  metaDescription: "Les articles classés « {{ tag }} »."
---

<div class="rayon">
	<header class="titre-page">
		<h1>Articles « {{ tag }} »</h1>
	</header>
	<div class="livret-page large liste-articles">
		{% set articles = collections[tag] | reverse %}
		{% include "components/articles.njk" %}
		<p><a class="lien-fort" href="/blog/">Tous les articles</a></p>
	</div>
</div>
